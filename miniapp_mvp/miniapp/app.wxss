page {
  background: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
               "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #1f2329;
}

.container { padding: 32rpx; min-height: 100vh; box-sizing: border-box; }

.label   { font-size: 26rpx; color: #4e5969; margin-top: 32rpx; }
.input,
.textarea {
  background: #fff;
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
  width: 100%;
  font-size: 28rpx;
}
.textarea { height: 200rpx; }

.primary {
  background: #1f2329;
  color: #fff;
  border-radius: 12rpx;
  margin-top: 40rpx;
  font-size: 30rpx;
}
.primary[disabled] {
  background: #c9cdd4 !important;
  color: #fff !important;
}

.hint   { font-size: 24rpx; color: #86909c; margin-top: 24rpx; text-align: center; }
.footer {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 48rpx;
  text-align: center;
  padding: 24rpx;
}
.error  { color: #f53f3f; font-size: 26rpx; margin-top: 16rpx; }
