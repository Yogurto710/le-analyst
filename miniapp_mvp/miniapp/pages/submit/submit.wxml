<view class="container">
  <!-- First-launch disclaimer modal -->
  <view wx:if="{{showDisclaimer}}" class="modal">
    <view class="modal-content">
      <view class="modal-title">使用须知</view>
      <view class="modal-body">
        Le Analyst 是公开信息检索与整理工具,所有内容仅基于公开来源整合,
        不构成任何投资建议、不提供买入/卖出/持有意见、不预测价格目标。
        所有结论需自行判断,使用本工具产生的任何后果由使用者自行承担。
      </view>
      <button class="primary" bindtap="acceptDisclaimer">我已知悉</button>
    </view>
  </view>

  <view class="form">
    <view class="title">研究简报</view>
    <view class="subtitle">输入股票代码和具体问题,系统将基于公开信息生成 2-3 分钟简报。</view>

    <view class="label">股票代码</view>
    <input class="input" placeholder="例如 AVGO" maxlength="10"
           bindinput="onTicker" value="{{ticker}}" />

    <view class="label">研究问题</view>
    <textarea class="textarea"
              placeholder="例如:为什么 AVGO 在 2026 年 6 月 4 日下跌 12.6%?"
              maxlength="500"
              bindinput="onQuestion"
              value="{{question}}" />

    <view class="label">输出语言</view>
    <view class="lang-toggle">
      <view class="opt {{lang === 'zh' ? 'on' : ''}}" data-lang="zh" bindtap="onLang">中文</view>
      <view class="opt {{lang === 'en' ? 'on' : ''}}" data-lang="en" bindtap="onLang">English</view>
    </view>
    <view class="hint hint-left" wx:if="{{langAuto}}">已根据问题语言自动选择,可点击切换</view>

    <button class="primary" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '提交'}}
    </button>

    <view wx:if="{{loginError}}" class="error">{{loginError}}</view>
    <view class="hint">每日额度:{{quotaHint}}</view>
  </view>

  <view class="footer">公开信息工具,非投资建议</view>
</view>
