.form { padding-top: 16rpx; }

.title    { font-size: 40rpx; font-weight: 600; margin-top: 16rpx; }
.subtitle { font-size: 26rpx; color: #4e5969; margin-top: 12rpx; line-height: 1.6; }

/* disclaimer modal */
.modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.modal-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  width: 600rpx;
  box-sizing: border-box;
}
.modal-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.modal-body  {
  font-size: 28rpx;
  line-height: 1.7;
  color: #4e5969;
  margin-bottom: 32rpx;
}
