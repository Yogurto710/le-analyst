<view class="container">
  <view class="report-body">
    <!-- <rich-text> renders the server-side markdown → HTML with inline
         styles. Falls back to a plain message if html is empty. -->
    <rich-text nodes="{{html}}" user-select="{{true}}" />
  </view>

  <view class="footer">
    本报告基于公开信息整理,不构成投资建议,
    不提供买入/卖出/持有意见,不预测价格目标。
  </view>
</view>
