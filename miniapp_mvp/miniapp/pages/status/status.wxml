<view class="container">
  <view class="status-card">
    <view wx:if="{{status === 'running' || status === 'pending'}}" class="mascot-wrap">
      <canvas wx:if="{{lottieReady}}" type="2d" id="lottie-knight" class="mascot-canvas"></canvas>
      <view wx:if="{{!lottieReady}}" class="mascot-fallback">⚙</view>
    </view>
    <view class="status-label">{{statusLabel}}</view>
    <view wx:if="{{phaseMsg}}" class="phase-msg">{{phaseMsg}}</view>
    <view class="status-elapsed">
      已用 {{elapsed}} 秒<text wx:if="{{toolCount > 0}}"> · 已调用 {{toolCount}} 次工具</text>
    </view>
    <view wx:if="{{status === 'running' || status === 'pending'}}" class="hint">
      {{waitHint}}
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{status === 'failed'}}" class="primary" bindtap="back">返回</button>
  </view>
  <view class="footer">公开信息工具,非投资建议</view>
</view>
