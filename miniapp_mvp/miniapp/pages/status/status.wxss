.status-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 32rpx 80rpx;
  text-align: center;
  margin-top: 80rpx;
}
.status-label   { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.phase-msg      { font-size: 28rpx; color: #1f2329; font-weight: 500; margin-bottom: 16rpx; }
.status-elapsed { font-size: 26rpx; color: #4e5969; }

.mascot-wrap {
  height: 280rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mascot-canvas {
  width: 280rpx;
  height: 280rpx;
}
.mascot-fallback {
  font-size: 220rpx;
  line-height: 1;
  color: #1f2330;
  animation: mascot-spin 4s linear infinite;
  will-change: transform;
  display: inline-block;
}
@keyframes mascot-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
