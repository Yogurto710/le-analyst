# Copy to .env (gitignored) and fill in. NEVER commit the populated file.
# Locally: webapp.py and analyst.py both auto-load this file on import.
# On a VPS: also copy these lines to /etc/le-analyst/env with mode 600
# (see miniapp_mvp/README.md Tier 2 walkthrough).

# Core analyst (research + initiate) — required for both CLI and mini-app backend
MOONSHOT_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# Mini-app backend — only needed when running webapp.py against real WeChat.
# Skip if you're running webapp.py with DEV_MODE=1 (smoke tests, local DevTools).
# Get these from mp.weixin.qq.com → 开发 → 开发管理 → 开发设置.
# AppID is public (compiled into every build); AppSecret is a credential.
WX_APPID=wx................
WX_SECRET=................................

# Optional knobs (defaults shown)
# DAILY_QUOTA=5
# JOB_TIMEOUT_S=600
