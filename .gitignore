.env
briefs/
briefs_en/
# briefs_ch/ is intentionally tracked — Chinese briefs are published so
# they can be read on a phone (GitHub web renders .md acceptably).
# reports/ is intentionally tracked from 2026-06-17 onward — new thesis-
# shaped initiate outputs are public. Pre-rebuild reports live in
# reports_legacy/ which stays private.
reports_legacy/
token_log/
# Planning / backlog docs are kept local — FEATURE_IDEAS.md and the
# pre-build planning notes live under planning_docs/ since 2026-06-24.
planning_docs/
.claude/
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
*.log
# WeChat DevTools per-developer local settings (sandbox/lint toggles, no shared value)
miniapp_mvp/miniapp/project.private.config.json
# Per-developer mini-app backend URL (localhost / tunnel / VPS) — see local.config.example.js
miniapp_mvp/miniapp/local.config.js
# npm artifacts for the mini-app (lottie-miniprogram + future deps)
# package.json/package-lock.json stay tracked so the dep set is pinned;
# node_modules/ and the DevTools-compiled miniprogram_npm/ are per-machine.
miniapp_mvp/miniapp/node_modules/
miniapp_mvp/miniapp/miniprogram_npm/
